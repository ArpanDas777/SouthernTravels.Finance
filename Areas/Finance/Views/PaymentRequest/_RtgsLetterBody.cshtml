@model RtgsLetterVm
@* The RTGS letter body (portrait A4). Every row carries its own sender account, cheque no., random no. and cheque date.
   Internal adds a "Total of amount" row; Bank has none. *@
@{ var rec = Model.Rec; var c = rec.Common; }
<p class="doc-to">To,<br>The Branch Manager,<br><b>@c.SenderBank Bank</b></p>
<p class="doc-subject">Subject: RTGS payment to @Model.Vendors beneficiary(ies) — total @Fmt.Inr(Model.Total)</p>
<p>Dear Sir / Madam,</p>
<p class="doc-text">
    Please debit our @c.SenderBank account against the cheque details given with each payment below and pay the beneficiaries by RTGS on the same day.
</p>

<div class="strip">Beneficiary details</div>
<table class="doc-table rtgs">
    <colgroup>
        <col style="width:3%"><col style="width:10%"><col style="width:8%"><col style="width:8%"><col style="width:8%">
        <col style="width:13%"><col style="width:12%"><col style="width:10%"><col style="width:18%"><col style="width:10%">
    </colgroup>
    <thead>
        <tr>
            <th>#</th><th>Sender Ac No.</th><th>Cheque No.</th><th>Random No.</th><th>Cheque Date</th>
            <th>Beneficiary Ac No.</th><th>IFSC</th><th class="r">Amount (₹)</th><th>Beneficiary Name</th><th>Remarks</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.N</td><td>@r.SenderAc</td><td>@r.ChequeNo</td><td>@r.RandomNo</td><td>@r.ChequeDate</td>
                <td class="nw">@r.BenAc</td><td class="nw">@r.Ifsc</td><td class="r b nw">@Fmt.Amt(r.Amount)</td><td><b>@r.BenName</b></td><td>@r.Remarks</td>
            </tr>
        }
    </tbody>
    @if (!Model.Bank)
    {
        <tfoot>
            <tr><td colspan="7">Total of amount</td><td class="r nw">@Fmt.Amt(Model.Total)</td><td colspan="2"></td></tr>
        </tfoot>
    }
</table>

<p class="doc-closing">Yours faithfully,<br><b>For Southern Travels Private Limited</b></p>
