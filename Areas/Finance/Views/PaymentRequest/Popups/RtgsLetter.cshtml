@model RtgsLetterVm
@{
    Layout = "_Modal";
    var rec = Model.Rec;
    var no = Uri.EscapeDataString(rec.No);
    ViewData["Title"] = Model.Name + (Model.Bank ? " Bank letter" : " Internal letter");
    ViewData["Sub"] = rec.No + " · " + Model.Rows.Count + " ticket(s) · " + Fmt.Inr(Model.Total);
    ViewData["Width"] = 900;
}
@* Portrait A4 letter, black on white. It is never reflowed: the frame (and the table inside the paper) scroll sideways on small screens. *@
<div class="doc-frame">
    <partial name="_RtgsLetter" model="Model" />
</div>
@section Footer {
    @if (Model.FromHistory)
    {
        <button type="button" class="btn" data-pop="@Model.HistUrl">Back to History</button>
    }
    <button type="button" class="btn" data-close>Close</button>
    <a class="btn btn-primary" href="@Model.PdfUrl@no&kind=@Model.Kind" target="_blank" rel="noopener">Download PDF</a>
}
