@model PrPayVm
@{
    Layout = "_Modal";
    var s = Model.Service; var b = s.Bk!;
    // Step 1 (Add Payment Details): no UTR. Step 2 (Update Payment Details): the same form, pre-filled, with the mandatory UTR. View: a paid entry.
    var step2 = b.HasDetails && !Model.ViewOnly;
    ViewData["Title"] = Model.ViewOnly ? "Payment Details" : step2 ? "Update Payment Details" : "Add Payment Details";
    ViewData["Sub"] = s.T.Id + " · " + s.V.Name + " · " + s.V.LegalName;
    ViewData["Width"] = 720;
    if (!Model.ViewOnly) { ViewData["Action"] = "PaymentPay"; }
    var payable = s.Bill?.Rec ?? 0;
}
<partial name="_Facts" model="@(new FactsBlock { Cols = 3, Strip = true, Items =
    [("Ticket No.", s.T.Id, G.Link, true), ("MBK No.", s.T.Mbk, null, false), ("File No.", s.T.File, null, false),
     ("Vendor Name", s.V.Name, null, false), ("Legal Name", s.V.LegalName, null, false), ("Service", s.IsAcc ? s.Hotel + " · " + s.Meal + " · " + s.RoomCat + " · " + s.Nights + "N" : s.Name, null, false),
     ("Approved Payable", Fmt.Inr(payable), G.Strong, true), ("Planned Mode", b.Pm ?? "RTGS", null, false), ("Bill No.", s.Bill?.No ?? "-", null, false)] })" />

<div class="sec">Payment Details</div>
<input type="hidden" name="sid" value="@s.Id" disabled="@Model.ViewOnly">
<partial name="_PayFields" model="@(new PayFieldsVm("Date of Payment", Model.ViewOnly, b.PaymentDate, b.CType, b.Mode, b.Bank, b.ChequeNo, b.Utr, AskUtr: step2))" />
@if (Model.ViewOnly)
{
    <div class="fields fields-3" style="margin-top:12px">
        <div class="fld"><span class="fld-l">Paid On</span><div class="fld-ro">@Fmt.Fdt(b.At)</div></div>
        <div class="fld"><span class="fld-l">Paid By</span><div class="fld-ro">@(b.By ?? "-")</div></div>
        <div class="fld"><span class="fld-l">Amount Paid</span><div class="fld-ro">@Fmt.Inr(b.AmountPaid > 0 ? b.AmountPaid : payable)</div></div>
    </div>
}
@section Footer {
    @if (Model.ViewOnly)
    {
        <button type="button" class="btn" data-close>Close</button>
    }
    else
    {
        <button type="button" class="btn" data-close>Cancel</button>
        <button type="submit" class="btn btn-confirm" data-needs-valid disabled>@(step2 ? "Mark as Paid" : "Save Payment Details")</button>
    }
}
