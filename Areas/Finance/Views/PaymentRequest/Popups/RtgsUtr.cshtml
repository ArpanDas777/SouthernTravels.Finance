@model RtgsUtrVm
@{
    Layout = "_Modal";
    ViewData["Title"] = "Update Details";
    ViewData["Sub"] = Model.Rec.No + " · " + Model.Items.Count + " ticket(s) — enter the UTR of each; the rest can follow later";
    ViewData["Width"] = 900;
    ViewData["Action"] = "RtgsUtr";
    var rows = Model.Items.Select(i => new UtrRow(i.S.Id, i.S, (i.S.Bill?.Rec ?? 0) - i.B.Tds, i.B.Paid, i.B.Utr)).ToList();
}
<partial name="_UtrTable" model="@(new UtrTableVm(Model.Rec.No, rows))" />
@section Footer {
    <button type="button" class="btn" data-close>Cancel</button>
    @if (rows.Any(r => !r.Paid))
    {
        <button type="submit" class="btn btn-confirm" data-needs-valid data-needs-utr disabled>Save UTR (0)</button>
    }
}
