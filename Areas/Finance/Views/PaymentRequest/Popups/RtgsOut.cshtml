@model RtgsOutVm
@{
    Layout = "_Modal";
    var name = Model.Bulk ? "Bulk Payment" : "RTGS";
    ViewData["Title"] = name + " Advice generated";
    ViewData["Sub"] = Model.Rec.No + " · " + Model.Count + " ticket(s) · " + Model.Vendors + " vendor(s) · " + Fmt.Inr(Model.Total);
    ViewData["Width"] = 560;
    var no = Uri.EscapeDataString(Model.Rec.No);
    var pdf = Model.Bulk ? "/Finance/Advance/BulkPdf?no=" : "/Finance/PaymentRequest/RtgsPdf?no=";
    var view = Model.Bulk ? "/Finance/Advance/Popup?t=bulkView&no=" : "/Finance/PaymentRequest/Popup?t=rtgsView&no=";
    var docs = new[]
    {
        (Kind: "internal", Title: name + " Internal", Note: "Vendor, amount and cheque details with a total — for Finance records."),
        (Kind: "bank", Title: name + " Bank", Note: "Beneficiary, account, IFSC and amount — to send to the bank."),
    };
}
<div class="rtgs-docs">
    @foreach (var d in docs)
    {
        <div class="rtgs-doc">
            <div class="flex1">
                <div class="b strong">@d.Title <span class="muted fs12">(PDF)</span></div>
                <div class="fs12 muted">@d.Note</div>
            </div>
            @* Get opens the letter on its own page, where Download PDF is the print dialog's Save as PDF. *@
            <a class="btn btn-sm" href="@pdf@no&kind=@d.Kind" target="_blank" rel="noopener">Get</a>
            <button type="button" class="btn btn-sm" data-pop="@view@no&kind=@d.Kind">View</button>
        </div>
    }
</div>
@section Footer {
    <button type="button" class="btn" data-close>Close</button>
    @* One printout with both letters, Internal first: choose Save as PDF in the print dialog. *@
    <a class="btn btn-primary" href="@pdf@no&kind=both" target="_blank" rel="noopener">Download both (PDF)</a>
}
