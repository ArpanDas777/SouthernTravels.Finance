@model RtgsSelVm
@{
    Layout = "_Modal";
    ViewData["Title"] = "Create RTGS Advice";
    ViewData["Sub"] = Model.Pool.Count + " ticket" + (Model.Pool.Count == 1 ? "" : "s") + " selected — set the payment details and the TDS % for each";
    ViewData["Width"] = 1000;
    ViewData["Action"] = "CreateRtgs";
    var total = Model.Pool.Sum(s => s.Bill?.Rec ?? 0);
    var vendors = Model.Pool.Select(s => s.Vi).Distinct().Count();
}
<div class="tot-strip" style="grid-template-columns:repeat(5,minmax(0,1fr))">
    <div><div class="l">Tickets selected</div><div class="v">@Model.Pool.Count</div></div>
    <div><div class="l">Vendors</div><div class="v">@vendors</div></div>
    <div><div class="l">Total amount</div><div class="v">@Fmt.Inr(total)</div></div>
    <div><div class="l">Total TDS</div><div class="v" data-tot-tds>₹0</div></div>
    <div><div class="l">Net payable</div><div class="v" style="color:var(--ok-ink)" data-tot-net>@Fmt.Inr(total)</div></div>
</div>

<div class="sec nobar">Payment Details</div>
<partial name="_PayFields" model="@(new PayFieldsVm("Date of Advance", AskRnd: true, DefaultMode: "RTGS"))" />

<div class="sec">Tickets</div>
<partial name="_TdsTable" model="@(new TdsTableVm("Payable", Model.Pool.Select(s => new TdsRow(s.Id, s, s.Bill?.Rec ?? 0)).ToList()))" />
@section Footer {
    <button type="button" class="btn" data-close>Cancel</button>
    <button type="submit" class="btn btn-confirm" data-needs-valid disabled>Submit (@Model.Pool.Count)</button>
}
