@model RtgsBothVm
@* Both RTGS letters in one printout: Internal first, then Bank, each on its own A4 page. *@
@{
    Layout = "_AdviceLayout";
    ViewData["Raw"] = true;
    ViewData["FileName"] = Model.Internal.Name + " Advice " + Model.Internal.Rec.No + " (Internal and Bank)";
    ViewData["ToolbarTitle"] = Model.Internal.Name + " letters · " + Model.Internal.Rec.No;
    ViewData["ToolbarHint"] = "Internal and Bank · " + Model.Internal.Rows.Count + " ticket(s) · " + Fmt.Inr(Model.Internal.Total);
}
@{ ViewData["SheetClass"] = "sheet-break"; }
<partial name="_RtgsLetter" model="Model.Internal" view-data="ViewData" />
@{ ViewData["SheetClass"] = ""; }
<partial name="_RtgsLetter" model="Model.Bank" view-data="ViewData" />
