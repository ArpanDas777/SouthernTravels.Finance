@model PayFieldsVm
@* Date, cheque type, payment mode, STPL bank account and cheque / request no. (plus the UTR and Random No. where asked), editable or read-only. *@
@{
    var ct = Model.CType ?? "Physical Cheque";
    var noLabel = ct == "E-Cheque" ? "Request No." : "Cheque No.";
}
<div class="fields fields-3">
    @if (Model.ViewOnly)
    {
        <div class="fld"><span class="fld-l">@Model.DateLabel</span><div class="fld-ro">@Fmt.Fd(Model.Date)</div></div>
        <div class="fld"><span class="fld-l">Cheque Type</span><div class="fld-ro">@(Model.CType ?? "-")</div></div>
        <div class="fld"><span class="fld-l">Payment Mode</span><div class="fld-ro">@(Model.Mode ?? "-")</div></div>
        <div class="fld"><span class="fld-l">Bank A/C (STPL)</span><div class="fld-ro">@(Model.Bank ?? "-")</div></div>
        <div class="fld"><span class="fld-l">@noLabel</span><div class="fld-ro">@(Model.No ?? "-")</div></div>
        <div class="fld"><span class="fld-l">UTR / Transaction No.</span><div class="fld-ro">@(Model.Utr ?? "-")</div></div>
    }
    else
    {
        <label class="fld"><span class="fld-l">@Model.DateLabel<span class="req" aria-hidden="true">*</span></span><input type="date" name="paymentDate" max="@Clock.Today" value="@(Model.Date ?? Clock.Today)" class="fld-in" data-req aria-required="true"></label>
        <label class="fld"><span class="fld-l">Cheque Type<span class="req" aria-hidden="true">*</span></span>
            <select name="ctype" class="fld-in sel" data-ctype data-req aria-required="true">
                @foreach (var c in FinanceOptions.ChequeTypes) { <option value="@c" selected="@(c == ct)">@c</option> }
            </select>
        </label>
        <label class="fld"><span class="fld-l">Payment Mode<span class="req" aria-hidden="true">*</span></span>
            <select name="mode" class="fld-in sel" data-req aria-required="true">
                @if (Model.DefaultMode == null) { <option value="">Select…</option> }
                @foreach (var m in FinanceOptions.AdvanceModes) { <option value="@m" selected="@(m == (Model.Mode ?? Model.DefaultMode))">@m</option> }
            </select>
        </label>
        <label class="fld"><span class="fld-l">Bank A/C (STPL)<span class="req" aria-hidden="true">*</span></span>
            <select name="bank" class="fld-in sel" data-req aria-required="true">
                <option value="">Select…</option>
                @foreach (var b in FinanceOptions.SenderBanks) { <option value="@b" selected="@(b == Model.Bank)">@b</option> }
            </select>
        </label>
        <label class="fld"><span class="fld-l"><span data-no-label>@noLabel</span><span class="req" aria-hidden="true">*</span></span><input type="text" name="no" value="@Model.No" class="fld-in" data-req aria-required="true"></label>
        @if (Model.AskRnd)
        {
            <label class="fld"><span class="fld-l">Random No.<span class="req" aria-hidden="true">*</span></span><input type="text" name="rnd" class="fld-in" data-req aria-required="true"></label>
        }
        @if (Model.AskUtr)
        {
            <label class="fld"><span class="fld-l">UTR / Transaction No.<span class="req" aria-hidden="true">*</span></span><input type="text" name="utr" class="fld-in" data-req aria-required="true"></label>
        }
    }
</div>
