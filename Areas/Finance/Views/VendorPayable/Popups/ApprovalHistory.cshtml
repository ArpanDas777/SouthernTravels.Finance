@model Svc
@{
    Layout = "_Modal";
    var b = Model.Bill!;
    ViewData["Title"] = "Approval History";
    ViewData["Sub"] = Model.T.Id + " · " + Model.V.Name + " · " + Model.V.LegalName;
    ViewData["Width"] = 760;
    // Each bill upload (oldest first), then the three approval levels.
    var versions = new List<Bill>(b.Hist) { b };
    string UpStatus(Bill v) => v.St == "D" ? "Disputed" : "Uploaded";
    string Remarks(Bill v) => "Bill " + (v.No != "" ? v.No : "-") + (string.IsNullOrEmpty(v.Mr) ? "" : " · " + v.Mr);
    (string Status, string Tone, string By, string At, string Remark) Level(Approval a, string who) => a.St switch
    {
        "A" => ("Approved", "ok", a.By ?? who, Fmt.Fdt(a.At), ""),
        "X" => (a.Kind ?? "Rejected", "danger", a.By ?? who, Fmt.Fdt(a.At), (a.Kind ?? "Rejected") + (string.IsNullOrEmpty(a.Reason) ? "" : ": " + a.Reason)),
        "Q" => ("Pending", "warn", "-", "-", ""),
        _ => ("Not reached", "off", "-", "-", ""),
    };
    (string Name, (string Status, string Tone, string By, string At, string Remark) L)[] levels =
        [("L1 · Finance", Level(b.L1, "Finance")), ("L2 · Management", Level(b.L2, "Management")), ("L3 · Senior Management", ("Not reached", "off", "-", "-", ""))];
}
<div class="tbl-scroll">
    <table class="pop-table stack-tbl">
        <thead><tr><th>Step</th><th>Action By</th><th>Status</th><th>Date &amp; Time</th><th>Remarks</th></tr></thead>
        <tbody>
            @for (var i = 0; i < versions.Count; i++)
            {
                var v = versions[i];
                <tr>
                    <td class="b">Bill upload @(i + 1)@(i == versions.Count - 1 ? " (latest)" : "")</td>
                    <td>Finance</td>
                    <td><span class="chip chip-@(v.St == "D" ? "danger" : "ok")">@UpStatus(v)</span></td>
                    <td class="nw">@Fmt.Fdt(v.Upl)</td>
                    <td>@Remarks(v) · <button type="button" class="fact-link" data-toast="No document is available yet.">@v.Doc</button> · @Fmt.Inr(v.Inv)</td>
                </tr>
            }
            @foreach (var (name, l) in levels)
            {
                <tr>
                    <td class="b">@name</td>
                    <td>@l.By</td>
                    <td><span class="chip chip-@l.Tone">@l.Status</span></td>
                    <td class="nw">@l.At</td>
                    <td>@(l.Remark != "" ? l.Remark : "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Footer {
    <button type="button" class="btn" data-close>Close</button>
}
