@model Svc
@{
    Layout = "_Modal";
    ViewData["Title"] = "Reject / Dispute Bill";
    ViewData["Sub"] = Model.T.Id + " · " + Model.V.Name + " · " + Model.V.LegalName;
    ViewData["Width"] = 480;
    ViewData["Action"] = "RejectBill";
}
<partial name="Popups/_BillHead" model="Model" />
<div class="fld" style="margin-top:12px">
    <span class="fld-l">Mark as<span class="req" aria-hidden="true">*</span></span>
    <span class="fld-in-check">
        <label class="fld-in-check"><input type="radio" name="kind" value="Rejected" checked> Rejected</label>
        <label class="fld-in-check" style="margin-left:16px"><input type="radio" name="kind" value="Disputed"> Disputed</label>
    </span>
</div>
<div style="margin-top:12px"><partial name="_ReasonField" model="@(new ReasonFieldVm("Why is this bill rejected or disputed?", [("sid", Model.Id)]))" /></div>
@section Footer {
    <button type="button" class="btn" data-close>Cancel</button>
    <button type="submit" class="btn btn-soft" data-needs-valid disabled>Mark Rejected / Disputed</button>
}
