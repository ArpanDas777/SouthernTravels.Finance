@model RaiseVm
@inject IConfiguration Config
@{
    Layout = "_Modal";
    var n = Model.Services.Count;
    // The scanner is reached through a small service on this PC (see Scanner:Url in appsettings.json).
    var scanUrl = Config["Scanner:Url"] ?? "";
    ViewData["Title"] = Model.Reupload ? "Reupload Bill" : "Upload Bill";
    ViewData["Sub"] = n == 1 ? Model.Services[0].V.Name + " · " + Model.Services[0].V.LegalName : n + " services selected — enter bill details for each";
    ViewData["Width"] = 860;
    ViewData["Action"] = "RaiseBill";
}
<input type="hidden" name="Reupload" value="@(Model.Reupload ? 1 : 0)">
@for (var i = 0; i < n; i++)
{
    var s = Model.Services[i];
    var last = Model.Reupload ? s.Bill : null;      // a reupload starts from the last upload's details (the file must be chosen again)
    var docs = FinanceOptions.DocTypes(s.V.Type);
    <div class="svc-block @(i > 0 ? "pop-head-sep" : "")" data-svc-block="@i" data-payable="@s.Neg" data-reupload="@(Model.Reupload ? 1 : 0)">
        @if (n > 1) { <div class="pop-head"><span>Service @(i + 1) of @n</span></div> }
        <partial name="Popups/_BillHead" model="s" />
        <input type="hidden" name="Items[@i].Sid" value="@s.Id">
        @* Bill date and bill no. share one line. *@
        <div class="fields fields-auto" style="--fmin:300px;margin-top:12px">
            <label class="fld"><span class="fld-l">Bill Date<span class="req" aria-hidden="true">*</span></span><input type="date" name="Items[@i].Date" value="@last?.Date" class="fld-in" data-req data-svc="@i" aria-required="true"></label>
            <label class="fld"><span class="fld-l">Bill No.<span class="req" aria-hidden="true">*</span></span><input type="text" name="Items[@i].No" value="@last?.No" class="fld-in" placeholder="INV-2026-0451" data-req data-svc="@i" aria-required="true"></label>
        </div>
        @* The main bill and the optional additional documents side by side; each is chosen from disk (Upload) or read from the scanner (Scan). *@
        <div class="fields fields-auto" style="--fmin:300px;margin-top:12px">
            <div class="fld"><span class="fld-l">Upload Bill — @docs[0]<span class="req" aria-hidden="true">*</span></span>
                <span class="scan-row" data-doc data-main data-pay="@s.Neg">
                    <input type="file" name="Items[@i].File" hidden data-req data-file data-svc="@i" aria-required="true">
                    <button type="button" class="btn btn-sm" data-upload-btn>Upload</button>
                    <button type="button" class="btn btn-sm" data-scan data-scan-url="@scanUrl">Scan</button>
                    <span class="scan-status" data-scan-status>No file chosen</span>
                </span>
            </div>
            <div class="fld"><span class="fld-l">Additional Docs <span class="faint">(optional)</span>@(docs.Length > 1 ? " — " + string.Join(", ", docs.Skip(1)) : "")</span>
                <span class="scan-row" data-doc>
                    <input type="file" name="Items[@i].Extra" hidden data-file data-svc="@i">
                    <button type="button" class="btn btn-sm" data-upload-btn>Upload</button>
                    <button type="button" class="btn btn-sm" data-scan data-scan-url="@scanUrl">Scan</button>
                    <span class="scan-status" data-scan-status>No file chosen</span>
                </span>
            </div>
            <label class="fld"><span class="fld-l">Amount as per Invoice (₹)<span class="req" aria-hidden="true">*</span></span><input type="number" min="1" step="1" name="Items[@i].Inv" value="@(last != null ? last.Inv.ToString() : "")" class="fld-in" placeholder="@s.Neg" data-req data-svc="@i" data-inv aria-required="true"></label>
            <label class="fld" data-mismatch hidden><span class="fld-l">Mismatch Reason <span class="faint">— invoice is above the vendor payable</span></span><input type="text" name="Items[@i].Mr" value="@last?.Mr" class="fld-in" placeholder="Why does the invoice differ from the vendor payable?"></label>
        </div>
        @* With several services, each can also be disputed on its own (the footer button disputes them all). *@
        @if (n > 1 && !Model.Reupload)
        {
            <div class="svc-actions">
                <button type="submit" name="Kind" value="D:@s.Id" class="btn btn-sm btn-soft" data-needs-dispute-svc="@i" disabled>Raise Dispute — @s.T.Id only</button>
            </div>
        }
    </div>
}
@* Reupload: every earlier upload of each service, newest first. *@
@if (Model.Reupload)
{
    <div class="sec">Upload history</div>
    @foreach (var s in Model.Services)
    {
        var versions = new List<Bill> { s.Bill! };
        versions.AddRange(Enumerable.Reverse(s.Bill!.Hist));
        <div class="pop-head" style="margin-top:8px"><span>@s.T.Id · @s.Name</span><span class="pop-head-r">@versions.Count upload@(versions.Count == 1 ? "" : "s")</span></div>
        @for (var v = 0; v < versions.Count; v++)
        {
            var h = versions[v];
            <div class="hist-item">
                <div><span class="chip chip-@(h.St == "D" ? "danger" : h.Approved ? "ok" : "off")">@(h.St == "D" ? "Disputed" : h.Approved ? "Uploaded" : "Pending")</span> @(v == 0 ? "· latest upload" : "")</div>
                <div class="hist-grid">
                    <div><div class="fact-l">Bill Date / No.</div>@Fmt.Fd(h.Date) · @(h.No != "" ? h.No : "-")</div>
                    <div><div class="fact-l">Document</div><button type="button" class="fact-link" data-toast="No document is available yet.">@h.Doc</button></div>
                    <div><div class="fact-l">Amount as per Invoice</div><span class="num">@Fmt.Inr(h.Inv)</span></div>
                    <div><div class="fact-l">Uploaded on</div>@Fmt.Fdt(h.Upl)</div>
                    @if (h.Mr != "") { <div style="grid-column:1/-1"><div class="fact-l">Mismatch Reason</div>@h.Mr</div> }
                </div>
            </div>
        }
    }
}
@section Footer {
    <button type="button" class="btn" data-close>Cancel</button>
    @if (!Model.Reupload)
    {
        <button type="submit" name="Kind" value="D" class="btn btn-soft" data-needs-dispute disabled>@(n > 1 ? "Raise Dispute (all)" : "Raise Dispute")</button>
    }
    <button type="submit" name="Kind" value="R" class="btn btn-confirm" data-needs-valid data-block-over="@(Model.Reupload ? 0 : 1)" disabled>Submit@(n > 1 ? $" ({n})" : "")</button>
}
