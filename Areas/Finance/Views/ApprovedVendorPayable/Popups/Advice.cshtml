@model AdviceVm
@{
    Layout = "_Modal";
    ViewData["Title"] = "Payment Submission Advice";
    ViewData["Sub"] = Model.ServiceCount + " service(s) · " + Model.VendorCount + " vendor(s)";
    ViewData["Width"] = 800;
    ViewData["Action"] = "Submit";
    ViewData["ClearsCart"] = "clear-cart-avp";
}
<input type="hidden" name="ids" value="@string.Join(",", Model.Ids)">
<div class="advice">
    <div class="advice-head">
        <div class="advice-brand">
            <span class="advice-logo">ST</span>
            <div>
                <div class="b strong">Southern Travels</div>
                <div class="fs12 muted">Finance Department — Vendor Payment Submission</div>
            </div>
        </div>
        <div class="advice-meta">
            <div>Advice No. <b class="num strong">@Model.No</b></div>
            <div>Issued On <b class="strong">@Model.Issued</b></div>
        </div>
    </div>
    <div class="tbl-scroll">
        <table class="advice-table stack-tbl" style="min-width:480px">
            <thead>
                <tr><th style="width:30px">#</th><th>Vendor</th><th>Payment Mode</th><th class="al-center">Tickets</th><th class="al-right">Amount</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="faint">@r.N</td>
                        <td><b class="strong">@r.Name</b> <span class="advice-id">@r.Id</span><div class="pop-sub">@r.Legal</div></td>
                        @* The mode is planned here, per vendor; RTGS unless changed. It carries into the Payment Request Report. *@
                        <td>
                            <select name="mode_@r.Vi" class="ctl" aria-label="Payment mode for @r.Name">
                                @foreach (var m in FinanceOptions.PlanModes)
                                {
                                    <option value="@m" selected="@(m == "RTGS")">@m</option>
                                }
                            </select>
                        </td>
                        <td class="al-center num">@r.Tickets</td>
                        <td class="al-right num b600">@r.Amt</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="advice-total">
        <span class="muted">@Model.Summary</span>
        <span class="advice-total-v">Total: @Model.Total</span>
    </div>
</div>
@section Footer {
    <button type="button" class="btn" data-close>Back</button>
    <button type="submit" class="btn btn-confirm" disabled="@(Model.ServiceCount == 0)">Confirm — Send to Payment Request</button>
}
