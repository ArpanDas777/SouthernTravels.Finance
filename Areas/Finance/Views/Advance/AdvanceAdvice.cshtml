@model AdvanceAdviceVm
@{
    Layout = "_AdviceLayout";
    var s = Model.Service;
    var a = Model.Req;
    var pay = Model.Pay;
    ViewData["FileName"] = Model.FileName;
    ViewData["DocClass"] = "color";
    ViewData["ToolbarTitle"] = "Advance Advice · " + Model.AdviceNo;
    ViewData["ToolbarHint"] = pay != null ? "Payment details included." : "Payment details will fill in once the payment is recorded.";
    ViewData["DocHead"] = new DocHead("ADVANCE PAYMENT ADVICE", [], "");
    ViewData["Footer"] = "Generated: " + Model.Generated;
    ViewData["Signs"] = new[] { "Ops Executive", "Ops Head", "Finance Head", "Management" };
}

<div class="refs">
    <div><span class="fl">Advice No</span><strong>@Model.AdviceNo</strong></div>
    <div><span class="fl">Date</span><strong>@Model.Date</strong></div>
    <div><span class="fl">File No</span><strong>@Model.FileNo</strong></div>
    <div><span class="fl">Adv. Request No</span><strong>@Model.RequestNo</strong></div>
</div>

<div class="strip">Vendor Details</div>
<div class="box cols-2">
    <div class="f"><div class="fl">Vendor Name</div><div class="fv">@s.V.Name</div></div>
    <div class="f"><div class="fl">Vendor Address</div><div class="fv">@Model.VendorAddress</div></div>
</div>

<div class="strip">Service &amp; Guest Details</div>
<div class="box cols-6">
    <div class="f"><div class="fl">Service Type</div><div class="mt2"><span class="svc svc-@FinanceG.SvcKey(s.V.Type)">@s.V.Type</span></div></div>
    <div class="f"><div class="fl">Guest Name</div><div class="fv">@s.T.Pax</div></div>
    <div class="f"><div class="fl">Pax — Adults</div><div class="fv">@s.T.Adults</div></div>
    <div class="f"><div class="fl">Pax — Children</div><div class="fv">@s.T.Children</div></div>
    <div class="f"><div class="fl">Service Start Date</div><div class="fv">@Fmt.Dmy(s.Start)</div></div>
    <div class="f"><div class="fl">Service End Date</div><div class="fv">@Fmt.Dmy(s.End)</div></div>
</div>

<div class="strip">Financial Details</div>
<div class="box cols-5">
    <div class="f"><div class="fl">Contracted Rate (₹)</div><div class="fv b">@Fmt.Amt(s.Contr)</div></div>
    <div class="f"><div class="fl">Negotiated Rate (₹)</div><div class="fv b">@Fmt.Amt(s.Neg)</div></div>
    <div class="f"><div class="fl">Total Service Cost (₹)</div><div class="fv b">@Fmt.Amt(Model.ServiceCost)</div></div>
    <div class="f"><div class="fl">Selling Rate (₹)</div><div class="fv b">@Fmt.Amt(s.Sell)</div></div>
    <div class="f"><div class="fl">Adv. Request Amt</div><div class="fv b">@Fmt.Inr(a.Amt) &nbsp;(@Fmt.Pct(a.Amt, s.Sell).Replace(".0%", "%"))</div></div>
</div>

@if (pay == null)
{
    <div class="strip">Payment Details — To Be Completed On Disbursement</div>
    <div class="box cols-4 ro">
        <div class="f span-12"><div class="fl">UTR / Ref No.</div><div class="blank">&nbsp;</div></div>
        @foreach (var label in new[] { "Bank Name", "Account No.", "IFSC", "Payment Date", "Mode of Payment", "Amount Paid (₹)" })
        {
            <div class="f"><div class="fl">@label</div><div class="blank">&nbsp;</div></div>
        }
    </div>
}
else
{
    <div class="strip strip-paid">Payment Details <span class="paid-tag">Paid</span></div>
    <div class="box cols-4 ro">
        <div class="f span-12"><div class="fl">@(pay.CType == "Online" ? "UTR / Ref No." : "Cheque / Ref No.")</div><div class="filled">@pay.No</div></div>
        <div class="f"><div class="fl">Bank Name</div><div class="filled">@pay.Bank</div></div>
        <div class="f"><div class="fl">Account No.</div><div class="filled">@Model.Kyc.Acc</div></div>
        <div class="f"><div class="fl">IFSC</div><div class="filled">@Model.Kyc.Ifsc</div></div>
        <div class="f"><div class="fl">Payment Date</div><div class="filled">@Fmt.Dmy(pay.PaymentDate)</div></div>
        <div class="f"><div class="fl">Mode of Payment</div><div class="filled">@pay.Mode (@pay.CType)</div></div>
        <div class="f"><div class="fl">Amount Paid (₹)</div><div class="filled">@Fmt.Amt(pay.AmountPaid)</div><div class="tds">Advance @Fmt.Inr(a.Amt) less TDS @pay.Pct.ToString("0.##", Fmt.Inv)% (@Fmt.Inr(pay.Tds))</div></div>
        <div class="f span-12"><div class="fl">Payment Slip</div><div class="filled">@(pay.Slip != "" ? pay.Slip : "-")</div></div>
        <div class="f span-34"><div class="fl">Added On</div><div class="filled">@Fmt.DmyTime(pay.Date)</div></div>
    </div>
}
