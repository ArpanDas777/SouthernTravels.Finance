@model AdvPayVm
@{
    Layout = "_Modal";
    var a = Model.Req; var s = Model.Service; var pay = a.Pay;
    // Step 1 (Add Payment Details): no UTR. Step 2 (Update Payment Details): the same form, pre-filled, with the mandatory UTR. View: a paid advance.
    var step2 = pay != null && !Model.ViewOnly;
    ViewData["Title"] = Model.ViewOnly ? "Payment Details" : step2 ? "Update Payment Details" : "Add Payment Details";
    ViewData["Sub"] = s.T.Id + " · " + s.V.Name + " · " + s.V.LegalName;
    ViewData["Width"] = 720;
    if (!Model.ViewOnly) { ViewData["Action"] = "AdvancePay"; }
    var balance = s.Neg - Model.EarlierAmt;
    var earlier = Model.EarlierCount == 0 ? "-" : Fmt.Inr(Model.EarlierAmt) + " (" + Model.EarlierCount + (Model.EarlierCount == 1 ? " advance" : " advances") + ")";
}
<partial name="_Facts" model="@(new FactsBlock { Cols = 3, Strip = true, Items =
    [("Ticket No.", s.T.Id, G.Link, true), ("MBK No.", s.T.Mbk, null, false), ("File No.", s.T.File, null, false),
     ("Vendor Name", s.V.Name, null, false), ("Legal Name", s.V.LegalName, null, false), ("Service", s.IsAcc ? s.Hotel + " · " + s.Meal + " · " + s.RoomCat + " · " + s.Nights + "N" : s.Name, null, false),
     ("Service City", s.V.City, null, false), ("Total Vendor Payable", Fmt.Inr(s.Neg), G.Strong, true), ("Advance Paid Earlier", earlier, Model.EarlierCount > 0 ? G.Green : null, false),
     ("Balance Pending", balance > 0 ? Fmt.Inr(balance) : "Nil", balance > 0 ? G.Red : G.Green, true), ("Advance Requested", Fmt.Inr(a.Amt), G.Blue, true)] })" />

<div class="sec">TDS &amp; Net Payable</div>
@* TDS %, TDS amount and the net payable on one line. *@
<div class="fields fields-3" data-tds-calc data-amt="@a.Amt">
    @if (Model.ViewOnly)
    {
        <div class="fld"><span class="fld-l">TDS %</span><div class="fld-ro">@pay!.Pct.ToString(Fmt.Inv)%</div></div>
        <div class="fld"><span class="fld-l">TDS Amount</span><div class="fld-ro">@Fmt.Inr(pay.Tds)</div></div>
        <div class="fld"><span class="fld-l">Net Payable (Advance − TDS)</span><div class="fld-ro">@Fmt.Inr(pay.Net)</div></div>
    }
    else
    {
        <input type="hidden" name="sid" value="@a.Sid">
        <label class="fld"><span class="fld-l">TDS %<span class="req" aria-hidden="true">*</span></span><input type="number" name="pct" min="0" max="100" step="0.01" placeholder="e.g. 2" value="@(pay?.Pct.ToString(Fmt.Inv))" class="fld-in" data-req data-pct aria-required="true"></label>
        <div class="fld"><span class="fld-l">TDS Amount</span><div class="fld-ro" data-tds>@(pay != null ? Fmt.Inr(pay.Tds) : "-")</div></div>
        <div class="fld"><span class="fld-l">Net Payable (Advance − TDS)</span><div class="fld-ro" data-net>@(pay != null ? Fmt.Inr(pay.Net) : "-")</div></div>
    }
</div>

<div class="sec">Payment Details</div>
<partial name="_PayFields" model="@(new PayFieldsVm("Date of Advance", Model.ViewOnly, pay?.PaymentDate, pay?.CType, pay?.Mode, pay?.Bank, pay?.No, pay?.Utr, AskUtr: step2))" />
@if (Model.ViewOnly)
{
    <div class="fields fields-3" style="margin-top:12px">
        <div class="fld"><span class="fld-l">Added Date &amp; Time</span><div class="fld-ro">@Fmt.Fdt(pay!.Date)</div></div>
        @if (pay.Rnd != "") { <div class="fld"><span class="fld-l">Random No.</span><div class="fld-ro">@pay.Rnd</div></div> }
        @if (pay.BulkNo != null) { <div class="fld"><span class="fld-l">Bulk Payment Advice</span><div class="fld-ro">@pay.BulkNo</div></div> }
    </div>
}
@section Footer {
    @if (Model.ViewOnly)
    {
        <a href="@FinanceG.AdviceUrl(a.Sid)" target="_blank" rel="noopener" class="btn">Print Advice</a>
        <button type="button" class="btn" data-close>Close</button>
    }
    else
    {
        <button type="button" class="btn" data-close>Cancel</button>
        <button type="submit" class="btn btn-confirm" data-needs-valid disabled>@(step2 ? "Mark as Paid" : "Save Payment Details")</button>
    }
}
