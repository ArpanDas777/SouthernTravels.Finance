@model KycRejectVm
@{
    Layout = "_Modal";
    ViewData["Title"] = "Reject " + Model.DocName;
    ViewData["Sub"] = Model.Vendor.Id + " · " + Model.Vendor.Name + " · " + Model.Vendor.LegalName + " · " + Model.DocName;
    ViewData["Width"] = 480;
    ViewData["Action"] = "RejectDoc";
}
<partial name="_ReasonField" model="@(new ReasonFieldVm("Why is this document rejected?", [("vi", Model.Vi.ToString()), ("key", Model.Key)]))" />
@section Footer {
    <button type="button" class="btn" data-close>Cancel</button>
    <button type="submit" class="btn btn-soft" data-needs-valid disabled>Reject</button>
}
