@{
    var ctx = (LayoutCtx)ViewData["Ctx"]!;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var nav = new (string Action, string Label, string Icon)[]
    {
        ("VendorPayable", "Vendor Payable Report", "M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"),
        ("Advance", "Advance Report", "M12 7v5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z"),
        ("ApprovedVendorPayable", "Approved Vendor Payable", "M20 6 9 17l-5-5"),
        ("PaymentRequest", "Payment Request Report", "M22 2 11 13M22 2l-7 20-4-9-9-4z"),
        ("VendorKyc", "Vendor KYC Report", "M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · Southern Travels Finance</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Public+Sans:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script>try { if (localStorage.getItem('fin.side') === 'closed') document.documentElement.classList.add('side-closed'); } catch (e) { }</script>
</head>
<body>
    <div class="app">
        <header class="topbar">
            <img src="~/img/logo-southern.png" alt="Southern Travels" class="topbar-logo">
            <span class="topbar-sep"></span>
            <span class="topbar-title">Southern Travels Finance</span>
            <span class="flex1"></span>
            <label class="topbar-search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
                <input placeholder="Search" aria-label="Search">
            </label>
            <span class="topbar-bell" aria-label="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"></path></svg>
                <span class="topbar-badge">3</span>
            </span>
            <span class="avatar">@ctx.UserName[0]</span>
            <div class="who">
                <div class="who-name">@ctx.UserName</div>
                <div class="who-role">@ctx.UserRole</div>
            </div>
            <form method="post" asp-controller="Finance" asp-action="SetUser" class="m0">
                <input type="hidden" name="returnUrl" value="@returnUrl">
                <select name="user" aria-label="Switch demo user" class="user-switch" data-autosubmit>
                    <option value="" disabled selected>Switch user</option>
                    <option value="admin">Admin User</option>
                    <option value="mounika">Mounika</option>
                    <option value="vijay">Vijay Gupta</option>
                </select>
            </form>
        </header>

        <div class="frame">
            <aside class="side">
                <button type="button" class="side-toggle" data-side-toggle aria-label="Collapse or expand menu"><span class="when-open">«</span><span class="when-closed">»</span></button>
                <div class="side-label"><span class="when-open">FINANCE</span><span class="when-closed">FIN</span></div>
                <nav class="side-nav">
                    @foreach (var n in nav)
                    {
                        <a asp-controller="Finance" asp-action="@n.Action" title="@n.Label" class="side-item @(ctx.Page == n.Action ? "active" : "")" aria-current="@(ctx.Page == n.Action ? "page" : null)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="@n.Icon"></path></svg>
                            <span class="side-text when-open">@n.Label</span>
                        </a>
                    }
                </nav>
            </aside>

            <div class="content">
                <main class="main">
                    <form method="post" asp-controller="Finance" asp-action="SetPeriod" class="bar m0" id="period-form">
                        <input type="hidden" name="returnUrl" value="@returnUrl">
                        <span class="bar-label">Period</span>
                        <select name="k" class="ctl ctl-28" data-autosubmit>
                            @foreach (var k in FinanceController.PeriodKinds)
                            {
                                <option value="@k" selected="@(k == ctx.PeriodKind)">@k</option>
                            }
                        </select>
                        @if (ctx.PeriodKind == "Custom")
                        {
                            <input type="date" name="from" value="@ctx.PeriodFrom" class="ctl ctl-28 num" data-autosubmit aria-label="Period from">
                            <span class="faint">→</span>
                            <input type="date" name="to" value="@ctx.PeriodTo" class="ctl ctl-28 num" data-autosubmit aria-label="Period to">
                        }
                        else
                        {
                            <input type="hidden" name="from" value="@ctx.PeriodFrom">
                            <input type="hidden" name="to" value="@ctx.PeriodTo">
                        }
                        @if (ctx.PeriodText != null)
                        {
                            <span class="period-info">Filtering by @ctx.PeriodField @ctx.PeriodText</span>
                            <button type="button" class="btn btn-sm btn-ghost" data-period-clear>Clear</button>
                        }
                    </form>

                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <div id="modal-root" class="scrim" hidden></div>
    <div id="tip" class="tip" hidden></div>
    <form id="seen-form" method="post" asp-controller="Finance" asp-action="Seen" hidden></form>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
