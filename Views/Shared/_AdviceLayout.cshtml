@*
    Layout for printable A4 advice documents (Advance Advice, Payment Advice).
    ViewData: FileName (title = default PDF name), ToolbarTitle, ToolbarHint, DocTitle, Generated,
              Signs (string[] signature roles), RemarkLines (int). Section "Meta": rows under the doc title.
*@
@{
    var signs = (string[])ViewData["Signs"]!;
    var remarkLines = (int)ViewData["RemarkLines"]!;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["FileName"]</title>
    <link rel="stylesheet" href="~/css/advice.css" asp-append-version="true">
</head>
<body>
    <div class="toolbar">
        <span class="toolbar-title">@ViewData["ToolbarTitle"]</span>
        <span class="toolbar-hint">@ViewData["ToolbarHint"]</span>
        <span class="flex1"></span>
        <button type="button" class="tb-btn tb-primary" data-print title="Opens the print dialog — choose “Save as PDF” as the destination">Download PDF</button>
        <button type="button" class="tb-btn" data-print>Print</button>
        <button type="button" class="tb-btn" onclick="window.close()">Close</button>
    </div>

    <section class="page">
        <img src="~/img/logo-southern.png" alt="" class="watermark">

        <div class="doc-head">
            <div class="company">
                <img src="~/img/logo-southern.png" alt="Southern Travels" class="company-logo">
                <div>
                    <div class="company-name">Southern Travels Private Limited</div>
                    <div class="company-line">Registered Address: [Address line 1, City, State, PIN], India</div>
                    <div class="company-line">GSTIN: [GSTIN Number] &nbsp;|&nbsp; Phone: [Phone] &nbsp;|&nbsp; Email: [Email]</div>
                </div>
            </div>
            <div class="doc-meta">
                <div class="doc-title">@ViewData["DocTitle"]</div>
                <div class="mt3">@RenderSection("Meta", required: true)</div>
                <div class="meta-gen">Generated: @ViewData["Generated"]</div>
            </div>
        </div>

        @RenderBody()

        <div class="strip">Remarks / Notes</div>
        <div class="remarks">
            @for (var i = 0; i < remarkLines; i++)
            {
                <div class="rl @(i == remarkLines - 1 ? "last" : "")">&nbsp;</div>
            }
        </div>

        <div class="signs">
            @foreach (var role in signs)
            {
                <div>
                    <div class="sign-role">@role</div>
                    <div class="sign-line">Signature</div>
                    <div class="sign-f">Name: __________</div>
                    <div class="sign-f mt4">Date: __________</div>
                </div>
            }
        </div>
    </section>

    <script>
        document.querySelectorAll('[data-print]').forEach(b => b.addEventListener('click', () => window.print()));
    </script>
</body>
</html>
