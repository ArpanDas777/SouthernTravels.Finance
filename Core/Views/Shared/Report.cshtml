@model ReportVm
@{
    ViewData["Title"] = Model.Title;
    var ctx = (LayoutCtx)ViewData["Ctx"]!;
    var q = Model.Query;
    var infoTip = G.TipJson([new TipLine(Model.Desc, wide: true)]);
}

<div class="titlerow">
    <h1>@Model.Title</h1>
    <button type="button" class="info-btn" aria-label="About this report" data-tip="@infoTip">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9.5"></circle><path d="M12 11v5.5M12 7.5v.01"></path></svg>
    </button>
    @if (Model.Pill)
    {
        @if (Model.Perm)
        {
            <span class="chip chip-warn">Actions enabled for you</span>
        }
        else
        {
            <span class="chip chip-off">Read only for you</span>
        }
    }
</div>

<div class="kpis">
    @foreach (var k in Model.Kpis)
    {
        <div class="kpi">
            <div class="kpi-label">@k.Label</div>
            <div class="kpi-value" style="color:@k.Color">@k.Value</div>
        </div>
    }
</div>

@if (Model.Tabs != null)
{
    <div class="tabs" role="tablist">
        @foreach (var t in Model.Tabs)
        {
            <a href="@t.Url" class="tab @(t.Active ? "active" : "")" role="tab" aria-selected="@(t.Active ? "true" : "false")">@t.Label</a>
        }
    </div>
}

<form method="get" action="@q.Path" id="report-form" class="m0 report-form">
    @if (q.View != "") { <input type="hidden" name="view" value="@q.View"> }
    @if (q.Sort != "") { <input type="hidden" name="sort" value="@q.Sort"><input type="hidden" name="dir" value="@q.Dir"> }
    <input type="hidden" name="fo" value="@(q.Fo ? "1" : "")" data-fo>

    <div class="bar">
        <input name="q" value="@q.Q" placeholder="@Model.Qph" class="ctl search-in" data-search autocomplete="off" aria-label="Search" autofocus="@(q.Q != "")">
        @if (Model.Filters != null)
        {
            <button type="button" class="btn @(q.Fo ? "btn-primary" : "")" data-filter-toggle aria-expanded="@(q.Fo ? "true" : "false")">
                Filters
                @if (Model.FCount > 0) { <span class="count-badge">@Model.FCount</span> }
            </button>
        }
        @if (Model.FCount > 0)
        {
            <a href="@Model.ClearAllUrl" class="btn btn-ghost">Clear all</a>
        }
        <span class="muted fs125">@Model.Count</span>
        <span class="flex1"></span>
        @foreach (var tb in Model.Tools)
        {
            <button type="button" class="btn @(tb.Primary ? "btn-primary" : "")" data-pop="@tb.Pop">@tb.Label</button>
        }
        @* Vendor Payable: bulk Raise Bill for the ticked services (Approved Vendor Payable uses the cart instead). *@
        @if (Model.SelLabel != null && !Model.Cart)
        {
            <button type="button" class="btn btn-confirm" data-sel-btn data-group="vp" data-pop-type="@Model.SelPopup" data-label="@Model.SelLabel" hidden>@Model.SelLabel</button>
        }
        @if (Model.HasExport)
        {
            <button type="button" class="btn" data-toast="Report exported.">Export</button>
        }
        @if (Model.HasExpand && Model.Rows.Count > 0)
        {
            <button type="button" class="btn" data-expand-all>Expand All</button>
        }
    </div>

    @if (Model.Filters != null)
    {
        @* Inline panel from 1100px up; a bottom sheet (scrim + panel) below that — see site.css. *@
        <div class="filters" data-filters hidden="@(!q.Fo)">
            <div class="filters-panel" role="dialog" aria-label="Filters">
                <div class="filters-head">
                    <span class="filters-title">Filters</span>
                    <button type="button" class="dialog-x" data-filter-toggle aria-label="Close filters">×</button>
                </div>
                <div class="filters-body">
                    @foreach (var f in Model.Filters)
                    {
                        <label class="filter">
                            @f.Label
                            <select name="@f.Name" class="ctl" data-autosubmit>
                                @foreach (var o in f.Opts)
                                {
                                    <option value="@o" selected="@(o == f.Value)">@o</option>
                                }
                            </select>
                        </label>
                    }
                    @if (Model.DateLabel != null)
                    {
                        <div class="filter">
                            @Model.DateLabel
                            <div class="filter-dates">
                                <input type="date" name="from" value="@q.From" class="ctl num" data-autosubmit aria-label="From">
                                <span class="faint">→</span>
                                <input type="date" name="to" value="@q.To" class="ctl num" data-autosubmit aria-label="To">
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</form>

<div id="toast" class="toast" role="status" hidden="@(ctx.Toast == null)">✓ <span data-toast-text>@ctx.Toast</span></div>

<div class="report-body">
<div class="report-main">
<div class="grid-wrap">
    <table class="grid">
        <thead>
            <tr>
                @foreach (var c in Model.Cols)
                {
                    if (c.SortUrl != null)
                    {
                        <th class="al-@c.Align sortable @(c.SortActive ? "sort-active" : "")"><a href="@c.SortUrl">@c.L</a></th>
                    }
                    else
                    {
                        <th class="al-@c.Align">@c.L</th>
                    }
                }
            </tr>
        </thead>
        @for (var i = 0; i < Model.Rows.Count; i++)
        {
            var row = Model.Rows[i];
            <tbody>
                <tr class="top @(i % 2 == 1 ? "alt" : "")" data-row="@row.Key" data-head="@row.CardHead" tabindex="0" aria-expanded="false">
                    <td class="cell card-h"><div class="cbox al-center">
                        @if (row.SeenVendor != null) { <span class="chev" data-seen="@row.SeenVendor" data-area="@row.SeenArea">›</span> }
                        else { <span class="chev">›</span> }
                    </div></td>
                    @* Under 1100px the row is a card: header (chevron + first fields), body (caption | value), footer (action column). *@
                    @for (var j = 0; j < row.Cells.Count; j++)
                    {
                        var col = j + 1 < Model.Cols.Count ? Model.Cols[j + 1] : null;
                        RenderCell(row.Cells[j], col?.L, j + 1 < row.CardHead ? "h" : col is { Action: true } ? "f" : "b");
                    }
                </tr>
                @if (row.Detail != null)
                {
                    <tr class="detail" hidden>
                        <td colspan="@(row.Cells.Count + 1)">
                            <div class="detail-box">
                                @{ RenderDetail(row.Detail); }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        }
    </table>
    @if (Model.Rows.Count == 0)
    {
        <div class="empty">@Model.EmptyText</div>
    }
</div>

@if (Model.Pager != null)
{
    <div class="pager">
        <span class="muted fs125">@Model.Pager.Label</span>
        <div class="pager-btns">
            @foreach (var p in Model.Pager.Pages)
            {
                if (p.Url == null)
                {
                    <span class="btn btn-sm pg is-disabled" aria-disabled="true">@p.Label</span>
                }
                else
                {
                    <a href="@p.Url" class="btn btn-sm pg @(p.Active ? "btn-primary" : "")" aria-current="@(p.Active ? "page" : null)">@p.Label</a>
                }
            }
        </div>
    </div>
}

</div>@* /report-main *@

@if (Model.SelLabel != null && Model.Cart)
{
    @* The cart (Approved Vendor Payable only). It appears once something is ticked: a side panel
       from 1100px up, a bottom sheet below that. Hidden, it leaves a "Cart (n)" pill. site.js fills it from the ticked boxes. *@
    <aside class="cart is-empty" data-cart data-group="avp" data-pop-type="@Model.SelPopup" data-label="@Model.SelLabel" data-total-label="Total to submit" role="region" aria-label="Cart">
        <div class="cart-head">
            <div class="cart-titles"><div class="cart-title">Cart</div><div class="cart-sub" data-cart-sub></div></div>
            <button type="button" class="btn btn-sm btn-ghost" data-cart-clear>Clear</button>
            <button type="button" class="cart-hide" data-cart-hide aria-label="Hide cart">▾</button>
        </div>
        <div class="cart-body" data-cart-list></div>
        <div class="cart-foot">
            <div class="flex1"><div class="cart-total-l" data-cart-total-label></div><div class="cart-total" data-cart-total></div></div>
            <button type="button" class="btn btn-confirm" data-cart-go></button>
        </div>
    </aside>
    <button type="button" class="cart-pill" data-cart-pill>Cart (<span data-cart-pill-n></span>) ▲</button>
}
</div>@* /report-body *@

@functions {
    /// <param name="label">Column caption, shown beside the value when drill-down rows become cards on phones.</param>
    /// <param name="role">Card section on phones: "h" header, "b" body, "f" footer.</param>
    void RenderCell(Cell cell, string? label = null, string role = "")
    {
        // Separate branches: Razor would write an empty data-label for a null value.
        if (string.IsNullOrEmpty(label))
        {
            <td class="cell @(role == "" ? "" : "card-" + role)"><div class="cbox al-@cell.Align">@foreach (var l in cell.Lines) { RenderLine(l); }</div></td>
        }
        else
        {
            <td class="cell @(role == "" ? "" : "card-" + role)" data-label="@label"><div class="cbox al-@cell.Align">@foreach (var l in cell.Lines) { RenderLine(l); }</div></td>
        }
    }

    // Razor writes data-* attributes even when the value is null, so nullable ones get their own branch.
    void RenderLine(Line l)
    {
        switch (l.Kind)
        {
            case LineKind.Text when l.Tip != null:
                <span style="@l.Style" data-tip="@l.Tip">@l.Text</span>
                break;
            case LineKind.Text:
                <span style="@l.Style">@l.Text</span>
                break;
            case LineKind.Dot:
                <span class="newdot" data-tip="@l.Tip" aria-label="New ticket(s) added"></span>
                break;
            case LineKind.Chip when l.Tip != null:
                <span class="chip chip-@l.Tone" data-tip="@l.Tip">@l.Text</span>
                break;
            case LineKind.Chip:
                <span class="chip chip-@l.Tone">@l.Text</span>
                break;
            case LineKind.Pill:
                <span class="pill"><span class="pill-dot" style="background:@l.DotColor"></span>@l.Text</span>
                break;
            case LineKind.Lv when l.Tip != null:
                <span class="lv lv-@l.Tone has-tip" aria-label="@l.Text" data-tip="@l.Tip">@l.Lvl @l.Glyph</span>
                break;
            case LineKind.Lv:
                <span class="lv lv-@l.Tone" aria-label="@l.Text">@l.Lvl @l.Glyph</span>
                break;
            case LineKind.Btn when l.Href != null:
                <a href="@l.Href" target="_blank" rel="noopener" class="btn btn-sm btn-@l.Variant">@l.Text</a>
                break;
            case LineKind.Btn when l.Pop != null:
                <button type="button" class="btn btn-sm btn-@l.Variant" disabled="@l.Disabled" data-pop="@l.Pop">@l.Text</button>
                break;
            case LineKind.Btn when l.ToastMsg != null:
                <button type="button" class="btn btn-sm btn-@l.Variant" disabled="@l.Disabled" data-toast="@l.ToastMsg">@l.Text</button>
                break;
            case LineKind.Btn:
                <button type="button" class="btn btn-sm btn-@l.Variant" disabled="@l.Disabled">@l.Text</button>
                break;
            case LineKind.Chk:
                <input type="checkbox" class="sel-chk" value="@l.Value" data-group="@l.Group" data-title="@l.Text" data-sub="@l.Sub" data-amt="@l.Amount" data-vi="@l.Vi" data-vid="@l.Vid" data-mbk="@l.Mbk" data-svc="@l.Svc" data-meta="@l.Meta" aria-label="Select service">
                break;
        }
    }

    void RenderDetail(Detail d)
    {
        if (d.Cols != null && d.Rows != null)
        {
            @* On phones each row becomes a card: header (first CardHead cells), body (caption | value rows), footer (last cell = actions). *@
            <table class="grid sub">
                <thead><tr>@foreach (var c in d.Cols) { <th class="al-@c.Align">@c.L</th> }</tr></thead>
                <tbody>
                    @for (var i = 0; i < d.Rows.Count; i++)
                    {
                        var cells = d.Rows[i];
                        <tr class="@(i % 2 == 1 ? "sub-alt" : "")" data-head="@d.CardHead">
                            @for (var j = 0; j < cells.Count; j++)
                            {
                                RenderCell(cells[j], d.Cols[j].L, j < d.CardHead ? "h" : j == cells.Count - 1 ? "f" : "b");
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (d.Panels != null)
        {
            <div class="panels" style="grid-template-columns:@d.PanelCols">
                @foreach (var p in d.Panels)
                {
                    <div class="panel">
                        <div class="panel-strip" style="background:@p.Strip">@p.Title</div>
                        @if (p.Docs != null)
                        {
                            <div class="panel-docs">
                                @foreach (var doc in p.Docs)
                                {
                                    <div class="doc-tile @(doc.Received ? "" : "pending")">
                                        <span class="doc-name">@doc.Name</span>
                                        @if (doc.Received)
                                        {
                                            <button type="button" class="btn btn-sm btn-ghost link" data-pop="@doc.Pop">View</button>
                                        }
                                        else
                                        {
                                            <span class="doc-pending">Pending</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="panel-facts">
                                @foreach (var f in p.Facts)
                                {
                                    <div style="@(f.Full ? "grid-column:1 / -1" : null)">
                                        <div class="fact-l">@f.L</div>
                                        <div class="fact-v @(f.Num ? "num" : "wrap")" style="color:@(f.Color ?? "var(--ink)");font-weight:@(f.Bold ? 700 : 400)">@f.V</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
}
